{"TOOLS" : {
    "reroute": {
        "description": "Trigger A* replanning to find a new path avoiding the hazard",
        "params": {
            "urgency":     "immediate|planned",
            "direction":   "port|starboard|any",
            "min_cpa_nm":  "float",
            "speed_kn":    "float|null"
        }
    },
    "slow_down": {
        "description": "Reduce speed without changing route",
        "params": {
            "speed_kn":  "float",
            "reason":    "safe_speed|restricted_visibility|traffic_density|precautionary"
        }
    },
    "stop": {
        "description": "Reduce to zero speed, hold position",
        "params": {
            "reason":  "collision_imminent|fog_signal_ahead|await_clearance"
        }
    },
    "hold": {
        "description": "Maintain current course and speed — stand-on vessel rights",
        "params": {
            "monitor_tcpa_min":  "float"
        }
    },
    "resume": {
        "description": "Return to planned route and speed after a deviation",
        "params": {
            "speed_kn": "float|null"
        }
    }
}
}