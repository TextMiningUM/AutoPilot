//-------------------------------------------------
// MOOS-IvP vehicle community: opship, LLM-DRIVEN VARIANT
// pHelmIvP is REMOVED from ANTLER below — no MOOS-native behavior/rule
// logic runs on this vehicle. colreg_llm_bridge.py is the sole source of
// DESIRED_HEADING / DESIRED_SPEED, connecting to this same MOOSDB as an
// independent client.
//
// Diff against a normal opship.moos (e.g. from the mission generator):
//   - "Run = pHelmIvP" removed from ANTLER
//   - opship.bhv is no longer referenced/needed
//   - everything else (uSimMarine, pMarinePID, uFldNodeBroker, pLogger)
//     is unchanged, since the bridge needs NAV_* and NODE_REPORT exactly
//     as before, and pMarinePID still needs to be running to consume
//     DESIRED_HEADING/DESIRED_SPEED.
//-------------------------------------------------
ServerHost = localhost
ServerPort = 9001
Community  = opship

MOOSTimeWarp = 1
// NOTE: keep time-warp at or near 1 while using a real LLM API in the
// loop — see the integration README for why.

LatOrigin  = 43.825300
LongOrigin = -70.330400

//------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 200
  Run = MOOSDB          @ NewConsole = false
  Run = pShare           @ NewConsole = false
  Run = pHostInfo        @ NewConsole = false
  Run = uFldNodeBroker    @ NewConsole = false
  Run = pNodeReporter      @ NewConsole = false
  Run = uSimMarine        @ NewConsole = false
  Run = pMarinePID        @ NewConsole = false
  Run = pLogger            @ NewConsole = false
  // Run = pHelmIvP  <-- intentionally NOT launched
}

//------------------------------------------
ProcessConfig = pShare
{
  AppTick    = 2
  CommsTick  = 2
  input      = route = localhost:9201
}

//------------------------------------------
ProcessConfig = pHostInfo
{
  AppTick    = 1
  CommsTick  = 1
}

//------------------------------------------
ProcessConfig = uFldNodeBroker
{
  AppTick   = 1
  CommsTick = 1

  TRY_SHORE_HOST      = localhost
  TRY_SHORE_PORT       = 9000
  TRY_SHORE_COMMUNITY  = shoreside

  BRIDGE  = src=VIEW_POLYGON
  BRIDGE  = src=VIEW_POINT
  BRIDGE  = src=VIEW_SEGLIST
  BRIDGE  = src=NODE_REPORT_LOCAL, alias=NODE_REPORT
  BRIDGE  = src=NODE_MESSAGE_LOCAL, alias=NODE_MESSAGE
}

//------------------------------------------
ProcessConfig = pNodeReporter
{
  AppTick    = 2
  CommsTick  = 2
  vessel_type = SHIP
}

//------------------------------------------
ProcessConfig = uSimMarine
{
  AppTick    = 10
  CommsTick  = 10

  START_POS  = 0,0,0,2.5
  PREFIX     = NAV
  MODEL_TYPE = holo
}

//------------------------------------------
ProcessConfig = pMarinePID
{
  AppTick     = 10
  CommsTick   = 10

  VERBOSE        = false
  DEPTH_CONTROL  = false
  ACTIVE_START   = true
  // ACTIVE_START=true means pMarinePID starts consuming DESIRED_HEADING /
  // DESIRED_SPEED immediately — the bridge script's first publish takes
  // effect right away, with no DEPLOY/MOOS_MANUAL_OVERRIDE step needed
  // (there's no pHelmIvP mode variable to gate on since pHelmIvP isn't
  // running). If you want a manual arm/disarm step instead, gate
  // pMarinePID on a variable your bridge script also publishes.

  YAW_PID_KP              = 1.2
  YAW_PID_KD               = 0.0
  YAW_PID_KI                = 0.3
  YAW_PID_INTEGRAL_LIMIT     = 0.07

  SPEED_PID_KP             = 1.0
  SPEED_PID_KD              = 0.0
  SPEED_PID_KI               = 0.0
  SPEED_PID_INTEGRAL_LIMIT    = 0.07

  MAXRUDDER    = 100
  MAXTHRUST    = 100
  SPEED_FACTOR  = 20
}

//------------------------------------------
ProcessConfig = pLogger
{
  AppTick        = 10
  CommsTick      = 10
  File           = LOG_OPSHIP_LLM
  PATH           = ./
  SyncLog        = true @ 0.2
  AsyncLog       = true
  WildCardLogging = true
}
