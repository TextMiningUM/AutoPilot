//-------------------------------------------------
// Behavior file for TARGET SHIP (straight-line, non-avoiding): ts1
//-------------------------------------------------
initialize   DEPLOY  = true
initialize   MODE    = ACTIVE

set MODE = ACTIVE {
  DEPLOY = true
} INACTIVE

//----------------------------------------------
Behavior = BHV_Waypoint
{
  name         = transit
  pwt          = 100
  condition    = MODE==ACTIVE
  perpetual    = true

  updates      = WPT_UPDATE
  speed        = 2.5
  capture_radius = 25
  slip_radius    = 50
  points         = 0.0,-2900.0
  repeat         = 0
}
