# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Pipeline artifacts — regenerated by the scripts, kept OUT of git so
# multiple users/clones never conflict on them. Each environment shares one
# copy via a symlink instead (see cloud/setup_user_clone.sh).
Data/VHF/VHF_Agents_Training/
Data/VHF/VHF_JSON/

# Downloaded model weights (Qwen 7B ~5 GB) — always ignored
_models/

# HuggingFace defaults (belt-and-braces if HF_HOME isn't overridden)
.cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Local-only architecture docs (private)
Docs/
