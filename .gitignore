# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Downloaded model weights (Qwen 7B ~5 GB) — always ignored, too large for git
_models/

# HuggingFace defaults (belt-and-braces if HF_HOME isn't overridden)
.cache/

# GitHub push-protection false positive: legislation.gov.uk's own internal
# CommentaryRef id scheme ("key-" + 32 hex chars) collides byte-for-byte with
# GitHub's Mailgun-API-key secret pattern. Real, harmless UK gov't legislation
# text, not a secret -- confirmed systemic across nearly every legislation.gov.uk
# XML download (5/6 pulled so far), reproducible any time via
# pipeline/ingest/build_captain_legal_corpus.py, so the whole folder is excluded
# rather than fought file-by-file with manual "allow secret" approvals.
# manifest.json (sha256/url/license provenance) stays tracked.
Data/Captain/Legal_Reference/uk_legislation/*.xml
# Same legislation.gov.uk false-positive pattern, this file is a copy of the
# already-excluded uk_marpol_air.xml above (Chief Engineer's own MARPOL Annex VI
# reference) -- reproducible via pipeline/ingest/build_chief_engineer_corpus.py.
Data/ChiefEngineer/ChiefEngineerManuals/legal_reference/*.xml

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# regenerable embedding caches (rebuilt on first use)
*.emb.npy
*_ragas_chunk_emb.npy

# Local-machine UI preferences (per-user, not project data)
Basic Simulator/Data/_ui_prefs.json
Basic Simulator/Data/_sweep_dashboard_ui_prefs.json

# Local/cloud-only safeguard snapshots (models_v1: model weights, way too
# large for git; Eval_v1: duplicates data already tracked under Data/OOW,Data/VHF)
models_v1/
Eval_v1/
_models_backup/

# Scratch/one-off scripts and run logs (repo convention: "_tmp_"-prefixed files are
# throwaway diagnostics, never meant to be committed permanently -- previously ~75 of
# these had accumulated at repo root / Basic Simulator root and were archived into
# _old_versions/scripts_and_logs/ on 2026-09-25; this prevents it recurring). The
# negation keeps that ARCHIVE itself trackable -- only NEW _tmp_*/log files elsewhere
# are ignored going forward.
_tmp_*.py
_tmp_*.sh
*.log
!**/_old_versions/**
