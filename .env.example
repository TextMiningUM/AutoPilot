# Copy this file to `.env` and fill in your keys.
# .env itself is git-ignored — never commit real keys.

# Required for:
#   - extract_reasoning.py (reasoning trace generation)
#   - eval_finetuned.py / score_ablation.py (Faith + Correct judge metrics)
OPENAI_API_KEY=sk-your-openai-key-here

# Required for:
#   - enriching the gold-standard files with atomic claims (gold_claims) in
#     batches (RAGAS migration) — Claude authors/annotates gold data so the
#     GPT-based judge never grades its own generator's output
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# Only needed when the key is NOT scoped to a workspace (API error 400 says so):
# the workspace ID from console.anthropic.com -> Settings -> Workspaces (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
